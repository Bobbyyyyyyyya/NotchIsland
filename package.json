{
  "name": "notch-island",
  "productName": "Notch Island",
  "version": "1.0.8",
  "description": "A macOS Dynamic Island for the notch: media player, volume, brightness, mic, battery, clipboard and more.",
  "main": "src/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "icon": "node tools/make-icon.js",
    "package": "electron-forge make",
    "dist": "electron-forge make && electron-forge publish",
    "selftest": "electron . --dev --selftest"
  },
  "keywords": [
    "macos",
    "notch",
    "dynamic-island",
    "menu-bar",
    "media-player"
  ],
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "@electron/notarize": "^2.5.0",
    "electron": "^44.10.1"
  },
  "overrides": {
    "fast-uri": "^3.1.9",
    "glob": "^14.0.3",
    "image-size": "^2.0.4",
    "appdmg": {
      "image-size": "0.7.5"
    },
    "minimatch": "^11.0.3",
    "tar": "^7.5.22",
    "tmp": "^0.2.7",
    "undici": "^7.30.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
